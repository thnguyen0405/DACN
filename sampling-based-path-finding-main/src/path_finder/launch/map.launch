<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="odom_topic" value="/visual_slam/odom" />
  <arg name="global_env_pcd2_topic" value="/random_forest/all_map" />

  <arg name="map_file" default="$(find path_finder)/../../../convex-region-graph/example_map.json"/>
  <arg name="map_xy_resolution" default="0.20"/>
  <arg name="map_z_resolution" default="0.20"/>
  <arg name="obstacle_z_min" default="-0.20"/>
  <arg name="obstacle_z_max" default="1.00"/>

  <!-- Publish the SAME example_map.json used by ACD/GCR/LLM. -->
  <node pkg="map_generator"
        name="example_map_publisher"
        type="example_map_publisher"
        output="screen">
    <param name="map_file" value="$(arg map_file)" type="str"/>
    <param name="xy_resolution" value="$(arg map_xy_resolution)" type="double"/>
    <param name="z_resolution" value="$(arg map_z_resolution)" type="double"/>
    <param name="obstacle_z_min" value="$(arg obstacle_z_min)" type="double"/>
    <param name="obstacle_z_max" value="$(arg obstacle_z_max)" type="double"/>
    <param name="publish_rate" value="1.0" type="double"/>
  </node>
</launch>
